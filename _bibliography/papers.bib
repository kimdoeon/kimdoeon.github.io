@article{kim2026csipose,
  abbr={ECCV 2026},
  title={WiFi-JEPA: Self-supervised Learning for WiFi-CSI 3D Human Pose Estimation},
  author={Doeon Kim* and Jungyoon Lee* and Seongsin Kim and Seongheum Kim},
  journal={<a href="https://eccv.ecva.net/">ECCV 2026</a>, Malm{\"o}, Sweden},
  pdf={https://arxiv.org/pdf/2607.11064},
  website={https://wifi-jepa.github.io/},
  preview={wifijepa.png},
  year={2026},
  month={9},
  selected={true},
  abstract={A CSI-native self-supervised framework that learns WiFi-CSI representations by predicting masked latent embeddings rather than reconstructing raw CSI, using CSI-aware tokenization and a ray-tracing-based synthetic-CSI pretraining pipeline. It improves 3D human-pose accuracy over supervised and prior CSI baselines, including in multi-person settings.}
}

